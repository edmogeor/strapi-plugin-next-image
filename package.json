{
  "name": "strapi-image",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "release": "./scripts/release.sh",
    "prepare": "husky",
    "fallow:check": "fallow",
    "fallow:fix": "fallow fix --yes"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
