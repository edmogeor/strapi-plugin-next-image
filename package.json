{
  "name": "strapi-image",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "release": "./scripts/release.sh",
    "prepare": "husky",
    "fallow:check": "fallow",
    "fallow:fix": "fallow fix --yes",
    "lint": "oxlint packages/",
    "lint:fix": "oxlint --fix packages/",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "husky": "^9.1.7",
    "react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0"
  }
}
